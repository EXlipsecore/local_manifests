<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- OnePlus 12R (aston / CPH2585 / CPH2611) - Infinity-X 17 -->
  <remote name="ex-gh"   fetch="https://github.com/EXlipsecore"   revision="17" />
  <remote name="ex-gl"   fetch="https://gitlab.com/EXlipsecore"  revision="17" />
  <remote name="lineage" fetch="https://github.com/LineageOS"    revision="lineage-24.0" />
  <!-- lineage remote only for repos not forked by EXlipsecore (pixelworks) -->
  <remote name="alpha"   fetch="https://gitlab.com/alphadroid-project" revision="alpha-16.2" />
  <remote name="crdroid" fetch="https://github.com/crDroidAndroid"     revision="17.0" />

  <!-- device -->
  <project path="device/oneplus/aston"          name="android_device_oneplus_aston"          remote="ex-gh" />
  <project path="device/oneplus/sm8550-common"  name="android_device_oneplus_sm8550-common"  remote="ex-gh" />

  <!-- kernel -->
  <project path="kernel/oneplus/sm8550"            name="android_kernel_oneplus_sm8550"            remote="ex-gh" />
  <project path="kernel/oneplus/sm8550-modules"    name="android_kernel_oneplus_sm8550-modules"    remote="ex-gh" />
  <project path="kernel/oneplus/sm8550-devicetrees" name="android_kernel_oneplus_sm8550-devicetrees" remote="ex-gh" />

  <!-- hardware -->
  <project path="hardware/oplus"                name="android_hardware_oplus"                remote="ex-gh" />
  <project path="hardware/pixelworks/interfaces" name="android_hardware_pixelworks_interfaces" remote="lineage" />

  <!-- sepolicy -->
  <project path="device/qcom/sepolicy_vndr/sm8550" name="android_device_qcom_sepolicy_vndr" remote="ex-gh" />

  <!-- vendor (blobs) -->
  <project path="vendor/oneplus/aston"           name="proprietary_vendor_oneplus_aston"           remote="ex-gl" />
  <project path="vendor/oneplus/sm8550-common"   name="proprietary_vendor_oneplus_sm8550-common"   remote="ex-gl" />
  <project path="vendor/oplus/camera"            name="proprietary_vendor_oplus_camera"            remote="ex-gl" />
  <project path="vendor/oneplus/ir"              name="vendor_oneplus_ir"                          remote="alpha" />
  <project path="vendor/oneplus/dolby"           name="proprietary_vendor_oneplus_dolby"           remote="crdroid" />
  <project path="packages/apps/LunarisDolby"     name="android_packages_apps_LunarisDolby"         remote="crdroid" />
</manifest>
