<?xml version="1.0" encoding="UTF-8"?>
<!-- Infinity-X 17 . OnePlus Ace 3 (astonc) . LOCAL MANIFEST
     usage:
       mkdir -p ~/infinity/.repo/local_manifests
       cp astonc.xml ~/infinity/.repo/local_manifests/
       cd ~/infinity and run: repo sync -c -j16   (full flags are in BUILD GUIDE.txt)
     after that the repos below already exist, so the manual git clone block is not needed.
     revisions: 17 = own build branch | lineage-24.0 = upstream blobs | alpha-16.2 = camera fork
     NOTE: use either this manifest OR the clone block, never both, or git complains
     that the destination already exists. -->
<manifest>
  <remote name="exgh"     fetch="https://github.com/EXlipsecore" />
  <remote name="exgl"     fetch="https://gitlab.com/EXlipsecore" />
  <remote name="muppets"  fetch="https://github.com/TheMuppets" />
  <remote name="lineage"  fetch="https://github.com/LineageOS" />
  <remote name="alpha"    fetch="https://gitlab.com/alphadroid-project" />
  <remote name="crdroid"  fetch="https://gitlab.com/crdroidandroid" />
  <remote name="crdroidg" fetch="https://github.com/crdroidandroid" />

  <!-- your trees, branch 17 -->
  <project path="device/oneplus/astonc"               name="android_device_oneplus_astonc"              remote="exgh" revision="17" />
  <project path="device/oneplus/sm8550-common"       name="android_device_oneplus_sm8550-common"      remote="exgh" revision="17" />
  <project path="kernel/oneplus/sm8550"              name="android_kernel_oneplus_sm8550"             remote="exgh" revision="17" />
  <project path="kernel/oneplus/sm8550-modules"      name="android_kernel_oneplus_sm8550-modules"     remote="exgh" revision="17" />
  <project path="kernel/oneplus/sm8550-devicetrees"  name="android_kernel_oneplus_sm8550-devicetrees" remote="exgh" revision="17" />
  <project path="hardware/oplus"                     name="android_hardware_oplus"                    remote="exgh" revision="17" />

  <!-- upstream side repos -->
  <project path="hardware/pixelworks/interfaces"     name="android_hardware_pixelworks_interfaces"    remote="lineage" revision="lineage-24.0" />

  <!-- blobs: your gitlab copies were deleted, public TheMuppets trees replace them -->
  <project path="vendor/oneplus/astonc"               name="proprietary_vendor_oneplus_astonc"          remote="muppets" revision="lineage-24.0" />
  <project path="vendor/oneplus/sm8550-common"       name="proprietary_vendor_oneplus_sm8550-common"  remote="muppets" revision="lineage-24.0" />

  <!-- camera: your only surviving gitlab fork -->
  <project path="vendor/oplus/camera"                name="vendor_oplus_camera"                       remote="exgl" revision="alpha-16.2" />

  <!-- extras the packs expect -->
  <project path="vendor/oneplus/ir"                  name="vendor_oneplus_ir"                         remote="alpha"   revision="alpha-16.2" />
  <project path="vendor/oneplus/dolby"               name="proprietary_vendor_oneplus_dolby"           remote="crdroid" revision="17.0" />
  <project path="packages/apps/LunarisDolby"         name="android_packages_apps_LunarisDolby"         remote="crdroidg" revision="17.0" />
</manifest>
