<?xml version="1.0" encoding="UTF-8"?>
<!-- Infinity-X 17 · OnePlus Ace 3 (China, PJE110)
     usage: mkdir -p .repo/local_manifests ; cp astonc.xml .repo/local_manifests/
            then run repo sync (see ROM guide for the exact flags).
     branch a17 = the Android 17 bringup (push it back once, see ROM guide)
     branch 17  = clean LineageOS 24 fork / vendor blobs
     note: no repo init args are needed here, this only ADDS projects. -->
<manifest>
  <remote name="exgh"     fetch="https://github.com/EXlipsecore" />
  <remote name="exgl"     fetch="https://gitlab.com/EXlipsecore" />
  <remote name="lineage"  fetch="https://github.com/LineageOS" />
  <remote name="alpha"    fetch="https://gitlab.com/alphadroid-project" />
  <remote name="crdroid"  fetch="https://gitlab.com/crdroidandroid" />
  <remote name="crdroidg" fetch="https://github.com/crdroidandroid" />

  <project path="device/oneplus/astonc"          name="android_device_oneplus_astonc"          remote="exgh" revision="a17" />
  <project path="device/oneplus/sm8550-common"       name="android_device_oneplus_sm8550-common"       remote="exgh" revision="a17" />

  <project path="kernel/oneplus/sm8550"              name="android_kernel_oneplus_sm8550"             remote="exgh" revision="a17" />
  <project path="kernel/oneplus/sm8550-modules"      name="android_kernel_oneplus_sm8550-modules"     remote="exgh" revision="a17" />
  <project path="kernel/oneplus/sm8550-devicetrees"  name="android_kernel_oneplus_sm8550-devicetrees" remote="exgh" revision="17" />

  <project path="hardware/oplus"                     name="android_hardware_oplus"                    remote="exgh" revision="a17" />
  <project path="hardware/pixelworks/interfaces"     name="android_hardware_pixelworks_interfaces"    remote="lineage" revision="lineage-24.0" />
  <project path="device/qcom/sepolicy_vndr/sm8550"   name="android_device_qcom_sepolicy_vndr"         remote="exgh" revision="a17" />

  <project path="vendor/oneplus/astonc"          name="proprietary_vendor_oneplus_astonc"     remote="exgl" revision="17" />
  <project path="vendor/oneplus/sm8550-common"       name="proprietary_vendor_oneplus_sm8550-common"  remote="exgl" revision="17" />
  <project path="vendor/oplus/camera"                name="proprietary_vendor_oplus_camera"           remote="exgl" revision="17" />

  <project path="vendor/oneplus/ir"                  name="vendor_oneplus_ir"                         remote="alpha"    revision="alpha-16.2" />
  <project path="vendor/oneplus/dolby"               name="proprietary_vendor_oneplus_dolby"          remote="crdroid"  revision="17.0" />
  <project path="packages/apps/LunarisDolby"         name="android_packages_apps_LunarisDolby"        remote="crdroidg" revision="17.0" />
</manifest>
